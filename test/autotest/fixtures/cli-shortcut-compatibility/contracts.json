    { "id": "enhanced-reopen", "sources": ["opencode"], "context": "reopen session tab", "strokes": ["Control+Shift+T"], "expect": { "distinctFrom": ["Control+T"] }, "knownGap": { "platforms": ["win32", "darwin", "linux"], "code": "no-delivery", "reason": "Modified letter has no legacy encoding." } },
    { "id": "input-undo", "sources": ["opencode"], "context": "input undo", "strokes": ["Control+-"], "expect": { "distinctFrom": ["-"] }, "knownGap": { "platforms": ["win32", "darwin", "linux"], "code": "no-delivery", "reason": "Control punctuation lacks a mapping." } },
