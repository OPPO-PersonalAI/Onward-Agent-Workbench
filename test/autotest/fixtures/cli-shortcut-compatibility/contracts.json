    { "id": "session-next", "sources": ["opencode"], "context": "session tab next, distinct from completion", "strokes": ["Control+Tab"], "expect": { "distinctFrom": ["Tab"] }, "knownGap": { "platforms": ["win32", "darwin", "linux"], "code": "aliases:Tab", "reason": "Legacy Tab encoding discards Control." } },
    { "id": "session-previous", "sources": ["opencode"], "context": "session previous, distinct from agent cycle", "strokes": ["Control+Shift+Tab"], "expect": { "distinctFrom": ["Shift+Tab"] }, "knownGap": { "platforms": ["win32", "darwin", "linux"], "code": "aliases:Shift+Tab", "reason": "Backtab encoding discards Control." } },
