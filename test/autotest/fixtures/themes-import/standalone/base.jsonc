{
  "name": "Parent",
  "type": "dark",
  "colors": {
    "editor.background": "#123",
    "editor.foreground": "#ABCDEF",
    "terminal.ansiRed": "#f008"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#888", "fontStyle": "italic" } },
    { "scope": ["string", "constant.numeric"], "settings": { "foreground": "#AABBCCDD" } }
  ]
}
