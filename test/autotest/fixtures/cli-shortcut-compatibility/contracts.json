  "authority": "Current official documentation, not locally installed CLI versions. Contracts concern host transport, not proof of application actions.",
  "sources": {
    "opencode": { "product": "OpenCode", "url": "https://opencode.ai/v2/docs/cli/keybinds", "scope": "V2 rolling defaults" },
    "claude": { "product": "Claude Code", "url": "https://code.claude.com/docs/en/interactive-mode", "scope": "Rolling interactive-mode documentation" },
    "claude-keys": { "product": "Claude Code", "url": "https://code.claude.com/docs/en/keybindings", "scope": "Rolling contextual keybindings" },
    "codex": { "product": "Codex", "url": "https://developers.openai.com/codex/cli/features/", "scope": "Rolling CLI documentation; no desktop shortcuts inferred" },
    "antigravity": { "product": "Antigravity CLI", "url": "https://antigravity.google/docs/cli/reference/", "scope": "Google agy interactive CLI, not IDE or Gemini CLI" },
    "antigravity-vim": { "product": "Antigravity CLI", "url": "https://antigravity.google/docs/cli/vim-editor-mode/", "scope": "Vim Insert and Normal submit versus newline" }
