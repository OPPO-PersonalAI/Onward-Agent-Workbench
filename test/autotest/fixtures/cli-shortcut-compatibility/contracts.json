  "unverified": [
    { "id": "native-platforms", "reason": "Pure parameterized tests do not prove native macOS/Linux menus, layouts, OS global shortcuts, or ConPTY behavior." },
    { "id": "attachment-result", "reason": "A delivered clipboard trigger is not proof of an image attachment. Actual CLI acknowledgment, image formats, and WSL/SSH clipboard reachability need integration tests." },
    { "id": "custom-cli-bindings", "reason": "User CLI overrides are not read; these are documentation contracts, not an inventory of every effective user keymap." },
    { "id": "antigravity-ctrl-z", "reason": "Official tips and changelog disagree about suspend versus undo; do not infer one global action." },
    { "id": "native-clipboard-access", "reason": "Native OS clipboard permissions and actual CLI bitmap decoding require platform-specific integration. Ordered paste, read rejection and disposal cancellation are unit-tested." },
    { "id": "enhanced-optional-flags", "reason": "The adapter supports Kitty flags 1/2/4; flags 8/16 and modifyOtherKeys are not advertised. Legacy-mode aliases are preserved deliberately; repaired keyboard profiles require application negotiation." }
  ],
  "cases": [
    { "id": "submit", "sources": ["opencode", "claude", "codex", "antigravity"], "context": "ordinary composer submit", "strokes": ["Enter"], "expect": { "hex": "0d" } },
    { "id": "newline-control-j", "sources": ["opencode", "claude", "codex", "antigravity"], "context": "composer newline", "strokes": ["Control+J"], "expect": { "hex": "0a" } },
    { "id": "newline-alt-enter", "sources": ["opencode", "claude", "codex", "antigravity"], "context": "composer newline alternative", "strokes": ["Alt+Enter"], "expect": { "hex": "1b0d" } },
    { "id": "newline-shift-enter", "sources": ["opencode", "claude", "codex", "antigravity"], "context": "newline must not alias submit", "strokes": ["Shift+Enter"], "expect": { "distinctFrom": ["Enter"] }, "knownGap": { "platforms": ["win32", "darwin", "linux"], "code": "aliases:Enter", "reason": "Legacy Enter encoding discards Shift." } },
    { "id": "modified-control-enter", "sources": ["opencode", "claude-keys", "antigravity-vim"], "context": "OpenCode newline, Claude send-now, or Vim submit: preserve identity, not one universal action", "strokes": ["Control+Enter"], "expect": { "distinctFrom": ["Enter"] }, "knownGap": { "platforms": ["win32", "darwin", "linux"], "code": "aliases:Enter", "reason": "Legacy Enter encoding discards Control." } },
    { "id": "tab", "sources": ["opencode", "claude", "codex", "antigravity"], "context": "completion or queue, owned by the active CLI surface", "strokes": ["Tab"], "expect": { "hex": "09" } },
