    { "id": "alt-down", "sources": ["opencode", "codex"], "context": "session/file or question navigation", "strokes": ["Alt+Down"], "expect": { "distinctFrom": ["Control+Down"] }, "knownGap": { "platforms": ["win32", "linux"], "code": "aliases:Control+Down", "reason": "Compatibility rewrite loses Alt-arrow identity." } },
