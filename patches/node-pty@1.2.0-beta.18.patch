diff --git a/src/win/onward_exit_callback.h b/src/win/onward_exit_callback.h
new file mode 100644
--- /dev/null
+++ b/src/win/onward_exit_callback.h
@@ -0,0 +1,41 @@
+// SPDX-FileCopyrightText: 2026 OPPO
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <node_api.h>
+#include <cstdio>
+#include <memory>
+
+namespace onward_pty {
+struct ExitEvent { int exit_code = 0; };
+inline void ReportStatus(const char* phase, napi_status status) noexcept {
+  if (status != napi_ok && status != napi_pending_exception && status != napi_cannot_run_js)
+    std::fprintf(stderr, "[node-pty] exit-%s Node-API status=%d\n", phase, static_cast<int>(status));
+}
+inline void CallExit(napi_env env, napi_value callback, void*, void* data) noexcept {
+  std::unique_ptr<ExitEvent> event(static_cast<ExitEvent*>(data));
+  // Raw TSFN dispatch includes null-env queue draining during teardown.
+  if (!event || !env || !callback) return;
+  napi_value receiver = nullptr;
+  napi_value argument = nullptr;
+  auto status = napi_get_undefined(env, &receiver);
+  if (status == napi_ok) status = napi_create_int32(env, event->exit_code, &argument);
+  if (status == napi_ok) status = napi_call_function(env, receiver, callback, 1, &argument, nullptr);
+  // Preserve real pending JS exceptions; shutdown on API <10 can return the
+  // same status without an exception. Neither case may throw a C++ exception.
+  ReportStatus("callback", status);
+}
+inline void QueueExit(napi_threadsafe_function tsfn, std::unique_ptr<ExitEvent> event) noexcept {
+  // Release before enqueue: the consumer may run before enqueue returns.
+  auto* payload = event.release();
+  const auto status = napi_call_threadsafe_function(tsfn, payload, napi_tsfn_blocking);
+  if (status != napi_ok) {
+    event.reset(payload);
+    // Closing consumes the producer's participation. Any further TSFN access
+    // (including release) is forbidden by the Node-API ownership contract.
+    if (status == napi_closing) return;
+    ReportStatus("enqueue", status);
+  }
+  const auto released = napi_release_threadsafe_function(tsfn, napi_tsfn_release);
+  if (released != napi_ok && released != napi_closing) ReportStatus("release", released);
+}
+} // namespace onward_pty
