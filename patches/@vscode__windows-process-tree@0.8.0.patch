diff --git a/src/onward_completion.h b/src/onward_completion.h
new file mode 100644
--- /dev/null
+++ b/src/onward_completion.h
@@ -0,0 +1,29 @@
+// SPDX-FileCopyrightText: 2026 OPPO
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <napi.h>
+#include <cstdio>
+namespace onward_process_tree {
+template <typename Callback>
+void CompleteSafely(napi_env env, const char* kind, Callback complete) {
+  try {
+    complete();
+  } catch (const Napi::Error& error) {
+    // Do not call ThrowAsJavaScriptException: Node may have disabled JS while
+    // draining AsyncWorker completions, so its exception translation can throw
+    // a second C++ error. Returning lets AsyncWorker destroy its owned payload.
+    bool pending = false;
+    napi_status status = napi_is_exception_pending(env, &pending);
+    if (status == napi_ok && pending) return;
+    napi_value exception = nullptr;
+    if (status == napi_ok)
+      status = napi_get_reference_value(env, static_cast<napi_ref>(error), &exception);
+    if (status == napi_ok) status = napi_throw(env, exception);
+    // An ordinary JS callback error is rethrown unchanged. During teardown,
+    // retain native-only evidence without entering another JS callback.
+    if (status != napi_ok)
+      std::fprintf(stderr, "[process-tree] completion kind=%s status=%d pending=%d\n",
+        kind, static_cast<int>(status), static_cast<int>(pending));
+  }
+}
+} // namespace onward_process_tree
